PORT=4000
# Change in production. Used to sign citizen session tokens.
JWT_SECRET=change-me-in-production
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
# Optional. When set, grievance triage uses Claude; otherwise the built-in bilingual keyword classifier runs.
ANTHROPIC_API_KEY=
# Hosted demo only: show the OTP on screen because no SMS gateway is connected.
SHOW_DEMO_OTP=false
# Optional language model for formal drafting, the Sahayak assistant, page translation and natural speech.
# Without it, the site uses the keyword classifier and the browser's own speech voices.
AI_API_KEY=
AI_MODEL=
AI_DRAFT_MODEL=
AI_TTS_MODEL=
# Optional WhatsApp Business (Cloud API). Without a token, messages are simulated in the demo phone at /whatsapp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional Supabase database (apply supabase/migrations first). Without it, data stays in data.json.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
