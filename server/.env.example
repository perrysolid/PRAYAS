PORT=4000
# Change in production. Used to sign citizen session tokens.
JWT_SECRET=change-me-in-production
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
# Optional. When set, grievance triage uses Claude; otherwise the built-in bilingual keyword classifier runs.
ANTHROPIC_API_KEY=
# Hosted demo only: show the OTP on screen because no SMS gateway is connected.
SHOW_DEMO_OTP=false
# Optional language model for formal drafting, the Sahayak assistant, page translation and natural speech.
# Without it, the site uses the keyword classifier and the browser's own speech voices.
AI_API_KEY=
AI_MODEL=
AI_DRAFT_MODEL=
AI_TTS_MODEL=
# Optional WhatsApp Business (Cloud API). Without a token, messages are simulated in the demo phone at /whatsapp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Postgres database (Neon recommended: its free plan sleeps when idle but never pauses the project).
# Use the pooled connection string. Tables are created on start. Takes precedence over Supabase.
DATABASE_URL=
# Optional Supabase database (apply supabase/migrations first). Without it, data stays in data.json.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Phone agent (Call 1905 answered by AI) ----
# Claude runs the conversation and writes officer briefs. Sarvam does speech in and out.
SARVAM_API_KEY=
# Optional; defaults to claude-haiku-5-5 for low latency.
VOICE_MODEL=
SARVAM_SPEAKER_HI=
SARVAM_SPEAKER_EN=
# Exotel Voicebot applet URL: wss://<api-host>/api/phone/exotel?secret=<PHONE_STREAM_SECRET>
PHONE_STREAM_SECRET=
# Shown on the website's practice-call page.
HELPLINE_PHONE_NUMBER=
# Calls handled at once (each holds two Sarvam sockets).
VOICE_MAX_CALLS=4
# Public https address of this API, used for the practice call's WebSocket and the keep-awake ping.
# On Render it is filled in automatically (RENDER_EXTERNAL_URL).
PUBLIC_API_URL=
# Optional Garhwali speech-to-text: see garhwali-asr/README.md.
GARHWALI_ASR_URL=
GARHWALI_ASR_TOKEN=

# ---- WhatsApp on an ordinary number (linked device, no Meta Business account) ----
# WA_LINK=on and the number with country code; the pairing code is printed in the server log.
# Apply supabase/migrations/20261125000000_wa_auth.sql so the login survives restarts.
WA_LINK=
WA_LINK_NUMBER=
# Officers who get WhatsApp briefs for new and escalated complaints, e.g. pwd:9876500001,*:9876500002
OFFICER_WHATSAPP=
